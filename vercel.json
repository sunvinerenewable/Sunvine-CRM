{
  "functions": {
    "api/ai-analyze.js": { "maxDuration": 30 },
    "api/catalog.js": { "maxDuration": 10 },
    "api/customer-files.js": { "maxDuration": 10 },
    "api/ledger.js": { "maxDuration": 10 },
    "api/places-nearby.js": { "maxDuration": 10 },
    "api/push-notify.js": { "maxDuration": 10 },
    "api/push-subscription.js": { "maxDuration": 10 },
    "api/quotations.js": { "maxDuration": 10 },
    "api/storage-delete.js": { "maxDuration": 10 },
    "api/storage-download.js": { "maxDuration": 10 },
    "api/storage-presign.js": { "maxDuration": 10 },
    "api/auth/[action].js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.googleapis.com https://*.geoapify.com; connect-src 'self' https://*.supabase.co https://generativelanguage.googleapis.com https://api.geoapify.com https://maps.googleapis.com; worker-src 'self' blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth/[action]?action=:action*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
