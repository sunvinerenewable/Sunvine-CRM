{
  "functions": {
    "api/ai-analyze.js": { "maxDuration": 30 },
    "api/catalog.js": { "maxDuration": 10 },
    "api/customer-files.js": { "maxDuration": 10 },
    "api/ledger.js": { "maxDuration": 10 },
    "api/places-nearby.js": { "maxDuration": 10 },
    "api/push-notify.js": { "maxDuration": 10 },
    "api/push-subscription.js": { "maxDuration": 10 },
    "api/quotations.js": { "maxDuration": 10 },
    "api/storage-delete.js": { "maxDuration": 10 },
    "api/storage-download.js": { "maxDuration": 10 },
    "api/storage-presign.js": { "maxDuration": 10 },
    "api/auth/[action].js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self' https://vercel.live; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vercel.live; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.googleapis.com https://maps.googleapis.com https://*.geoapify.com https://*.r2.cloudflarestorage.com https://vercel.live https://vercel.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://generativelanguage.googleapis.com https://api.geoapify.com https://maps.googleapis.com https://*.r2.cloudflarestorage.com https://vercel.live https://*.pusher.com; frame-src 'self' https://vercel.live; worker-src 'self' blob:;"
        }
      ]
    },
    {
      "source": "/(index\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron/purge-trash",
      "destination": "/api/customer-files?action=purge-trash"
    },
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth/[action]?action=:action*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|sw\\.js|favicon|robots\\.txt|sitemap\\.xml|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
